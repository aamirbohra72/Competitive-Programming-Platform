# Copy to apps/api/.env (or add the same keys to the monorepo root .env).
# Without BREVO_* / SMTP_*, OTP is NOT sent by email in development.

PORT=3001
DATABASE_URL="postgresql://user:password@localhost:5432/codeforces?schema=public"
JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"
NODE_ENV=development

# Brevo (https://app.brevo.com → SMTP & API)
# - API key:  xkeysib-...  (HTTP transactional API)
# - SMTP key: xsmtpsib-... (smtp-relay.brevo.com) — also supported in BREVO_API_KEY
# Sender must be verified in Brevo → Senders.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=you@example.com
BREVO_SENDER_NAME=Codeforces Platform
# BREVO_SMTP_LOGIN=you@example.com

# Optional fallback: classic SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Codeforces <noreply@yourdomain.com>"

# Interview (/api/interview): Mistral for STT + grading (server-only; never NEXT_PUBLIC_*).
MISTRAL_API_KEY=
# MISTRAL_CHAT_MODEL=mistral-small-latest
# MISTRAL_TRANSCRIBE_MODEL=voxtral-mini-latest
# Production: set INTERVIEW_ENABLED=true to expose interview routes.

# Career Hub (/api/careers/hub): fetches live listings from Himalayas + Remotive (no API key required).
# Cached ~30–60 minutes; POST /api/careers/hub/refresh bypasses cache.

# Clerk (server verification for /api/auth/clerk-exchange)
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# Optional: tolerate OS clock drift when verifying Clerk session JWTs (default 120000 ms)
# CLERK_CLOCK_SKEW_MS=120000

# Razorpay (server-only secret — never NEXT_PUBLIC_*)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks. Distinct from KEY_SECRET. POST /api/payments/webhook
RAZORPAY_WEBHOOK_SECRET=
# Set to false to skip Razorpay boot checks in production
# PAYMENTS_ENABLED=true

# Optional Redis (leaderboards / cache). If set, /api/ready requires a ping.
# REDIS_URL=redis://127.0.0.1:6379

# Judge
# JUDGE_ENABLED=true
# JUDGE_CONCURRENCY=2
# JUDGE_QUEUE_MAX=8
# JUDGE_PENDING_TIMEOUT_MS=600000
# JUDGE_DOCKER_IMAGE=codeforces-judge:1

