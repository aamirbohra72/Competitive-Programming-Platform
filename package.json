{
  "name": "codeforces-platform",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:free-ports": "node scripts/free-dev-ports.mjs",
    "dev": "node scripts/free-dev-ports.mjs && turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:migrate:dev": "npm run db:migrate:dev -w @codeforces/db",
    "db:push": "turbo run db:push",
    "db:seed": "turbo run db:seed",
    "db:studio": "turbo run db:studio",
    "test:smoke": "node scripts/functional-smoke.mjs",
    "test:prod": "node scripts/functional-smoke.mjs && node scripts/production-validate.mjs"
  },
  "devDependencies": {
    "prettier": "^3.2.5",
    "turbo": "^2.0.0",
    "typescript": "^5.3.3"
  },
  "packageManager": "npm@9.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}


