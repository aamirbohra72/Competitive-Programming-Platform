// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
  TA
}

enum ContestStatus {
  UPCOMING
  LIVE
  ENDED
}

/// PRACTICE hosts the /practice catalog; RATED/UNRATED are time-boxed public contests
enum ContestKind {
  PRACTICE
  RATED
  UNRATED
}

enum SubmissionStatus {
  PENDING
  ACCEPTED
  WRONG_ANSWER
  TIME_LIMIT_EXCEEDED
  RUNTIME_ERROR
  COMPILATION_ERROR
}

enum JudgeMode {
  STDIN
  JS_FUNCTION
  REACT_COMPONENT
}

enum InterviewSessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum InterviewVerdict {
  SELECT
  REJECT
  BORDERLINE
}

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  username    String   @unique
  role        UserRole @default(USER)
  clerkUserId String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  submissions          Submission[]
  leaderboardEntries   LeaderboardEntry[]
  interviewSessions    InterviewSession[]
  contestRegistrations ContestRegistration[]
  courses              Course[]
  topicProgress        Progress[]
  paymentOrders        PaymentOrder[]
  enrollments          Enrollment[]
  courseLearning       CourseLearningProgress[]
  learningStreak       LearningStreak?
  taHelpRequests       TaHelpRequest[] @relation("TaHelpLearner")
  taHelpAssigned       TaHelpRequest[] @relation("TaHelpAssignee")
  taHelpReplies        TaHelpReply[]
  acceptedSolutions    AcceptedSolution[]

  @@index([email])
  @@index([username])
  @@index([clerkUserId])
}

model OTP {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([code])
}

model LeaderboardEntry {
  id        String   @id @default(cuid())
  userId    String
  contestId String
  score     Int      @default(0)
  rank      Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)

  @@unique([userId, contestId])
  @@index([contestId, score])
  @@index([contestId, rank])
}

model Contest {
  id          String        @id @default(cuid())
  /// Stable identity for seed upserts (e.g. "weekly-sprint-1")
  slug        String?       @unique
  name        String
  description String?
  startTime   DateTime
  endTime     DateTime
  status      ContestStatus @default(UPCOMING)
  kind        ContestKind   @default(UNRATED)
  /// Hidden from public list until published (admin drafts)
  isPublished Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  challenges         Challenge[]
  leaderboardEntries LeaderboardEntry[]
  registrations      ContestRegistration[]

  @@index([status])
  @@index([kind])
  @@index([isPublished])
  @@index([startTime])
  @@index([endTime])
}

model ContestRegistration {
  id           String   @id @default(cuid())
  userId       String
  contestId    String
  registeredAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)

  @@unique([userId, contestId])
  @@index([contestId])
  @@index([userId])
}

model Challenge {
  id               String    @id @default(cuid())
  contestId        String
  /// Stable identity for upserts / catalog validation
  slug             String?   @unique
  title            String
  description      String
  difficulty       String
  inputFormat      String
  outputFormat     String
  constraints      String
  sampleInput      String
  sampleOutput     String
  /// Interview practice: "JavaScript" | "React.js" — optional for legacy algorithmic tasks
  practiceLanguage String?
  /// Companies commonly associated with this prompt (for filtering / badges)
  companies        String[]  @default([])
  /// Display-only estimate, e.g. "15 mins"
  estimatedTime    String?
  judgeMode        JudgeMode @default(STDIN)
  allowedLanguages String[]  @default(["javascript"])
  starterCode      String?
  /// When false, problem is visible but submissions are rejected until tests are ready
  judgeReady       Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  contest     Contest             @relation(fields: [contestId], references: [id], onDelete: Cascade)
  submissions Submission[]
  testCases   ChallengeTestCase[]
  acceptedSolutions AcceptedSolution[]

  @@index([contestId])
  @@index([difficulty])
  @@index([practiceLanguage])
  @@index([judgeMode])
  @@index([judgeReady])
}

model ChallengeTestCase {
  id             String   @id @default(cuid())
  challengeId    String
  name           String   @default("case")
  input          String
  expectedOutput String
  /// Optional harness/spec payload (JSON) for JS_FUNCTION / REACT_COMPONENT modes
  specJson       String?
  isSample       Boolean  @default(false)
  isHidden       Boolean  @default(true)
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@index([challengeId])
  @@index([challengeId, order])
}

model Submission {
  id          String           @id @default(cuid())
  userId      String
  challengeId String
  language    String
  sourceCode  String
  status      SubmissionStatus @default(PENDING)
  score       Int              @default(0)
  /// Legacy free-text feedback (kept for backwards compatibility)
  aiResponse  String?
  /// Structured judge diagnostics JSON (passed/total, cases, verdict details)
  resultJson  String?
  /// Conceptual AI/deterministic hint for wrong solutions (never reveals full answer)
  hintText    String?
  submittedAt DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  acceptedSolution AcceptedSolution?

  @@index([userId])
  @@index([challengeId])
  @@index([status])
  @@index([submittedAt])
  @@index([status, submittedAt])
  @@index([score])
}

/// Canonical accepted solution per user+challenge (unlocked Solution tab / resume later).
model AcceptedSolution {
  id           String   @id @default(cuid())
  userId       String
  challengeId  String
  submissionId String   @unique
  language     String
  sourceCode   String
  score        Int      @default(100)
  /// First time this user solved the challenge
  firstAcceptedAt DateTime @default(now())
  /// Last time an equal-or-better accepted submission replaced the stored code
  updatedAt    DateTime @updatedAt

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge   Challenge  @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  submission  Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeId])
  @@index([userId])
  @@index([challengeId])
  @@index([firstAcceptedAt])
}

model InterviewSession {
  id                  String                 @id @default(cuid())
  userId              String
  template            String
  mode                String                 @default("PRACTICE")
  resumeContext       String?                @db.Text
  awayWarnings       Int                    @default(0)
  status              InterviewSessionStatus @default(IN_PROGRESS)
  startedAt           DateTime               @default(now())
  endsAt              DateTime
  currentQuestion     Int                    @default(0)
  currentQuestionText String?
  verdict             InterviewVerdict?
  overallScore        Int?
  summaryJson         String?
  reportDetail        String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  turns InterviewTurn[]

  @@index([userId])
  @@index([status])
}

model InterviewTurn {
  id           String   @id @default(cuid())
  sessionId    String
  order        Int
  questionText String
  transcript   String
  score        Int      @default(0)
  llmFeedback  String?
  createdAt    DateTime @default(now())

  session InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, order])
  @@index([sessionId])
}

model Course {
  id            String   @id @default(cuid())
  title         String
  description   String
  sourceType    String
  sourceContent String   @db.Text
  createdBy     String
  createdAt     DateTime @default(now())

  creator User   @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  units   Unit[]

  @@index([createdBy])
}

model Unit {
  id               String   @id @default(cuid())
  courseId         String
  course           Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title            String
  description      String   @db.Text
  order            Int
  estimatedMinutes Int
  tags             String[]
  topics           Topic[]

  @@index([courseId, order])
}

model Topic {
  id               String   @id @default(cuid())
  unitId           String
  unit             Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  title            String
  type             String
  order            Int
  estimatedMinutes Int
  content          String   @db.Text
  mcqs             MCQ[]
  progress         Progress[]

  @@index([unitId, order])
}

model MCQ {
  id           String @id @default(cuid())
  topicId      String
  topic        Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)
  question     String @db.Text
  options      String[]
  correctIndex Int
  explanation  String @db.Text

  @@index([topicId])
}

model Progress {
  id            String   @id @default(cuid())
  userId        String
  topicId       String
  completed     Boolean  @default(false)
  score         Int?
  lastAttemptAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@index([userId])
}

enum PaymentStatus {
  CREATED
  PAID
  FAILED
}

model PaymentOrder {
  id                String        @id @default(cuid())
  userId            String
  productId         String
  productTitle      String
  amountPaise       Int
  currency          String        @default("INR")
  status            PaymentStatus @default(CREATED)
  razorpayOrderId   String        @unique
  razorpayPaymentId String?       @unique
  razorpaySignature String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([productId])
  @@index([status])
}

model RazorpayWebhookEvent {
  id        String   @id @default(cuid())
  eventId   String   @unique
  event     String
  createdAt DateTime @default(now())
}

model Enrollment {
  id        String   @id @default(cuid())
  userId    String
  productId String
  orderId   String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

/// Aggregated progress for catalog (/learn/:id) or generated notebook courses.
model CourseLearningProgress {
  id             String   @id @default(cuid())
  userId         String
  courseId       String
  courseKind     String   @default("catalog") // catalog | generated
  title          String?
  completedCount Int      @default(0)
  totalCount     Int      @default(0)
  percent        Int      @default(0)
  completed      Boolean  @default(false)
  lastItemId     String?
  lastItemTitle  String?
  lastItemHref   String?
  lastActivityAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CourseLearningItem[]

  @@unique([userId, courseId])
  @@index([userId, lastActivityAt])
  @@index([courseId])
}

model CourseLearningItem {
  id          String    @id @default(cuid())
  progressId  String
  itemId      String
  itemType    String // tutorial | module | topic | assignment
  title       String?
  completed   Boolean   @default(false)
  score       Int?
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  progress CourseLearningProgress @relation(fields: [progressId], references: [id], onDelete: Cascade)

  @@unique([progressId, itemId])
  @@index([progressId])
}

model LearningStreak {
  id             String   @id @default(cuid())
  userId         String   @unique
  currentStreak  Int      @default(0)
  longestStreak  Int      @default(0)
  lastActiveDate String? // YYYY-MM-DD (UTC)
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum TaHelpStatus {
  WAITING
  CLAIMED
  REPLIED
  RESOLVED
  OPEN_POOL
}

enum TaHelpType {
  TEXT
  VIDEO
}

model TaHelpRequest {
  id             String       @id @default(cuid())
  userId         String
  title          String
  type           TaHelpType
  status         TaHelpStatus @default(WAITING)
  problem        String
  topic          String
  language       String
  description    String       @db.Text
  preferredSlot  String?
  source         String       @default("web") // web | companion
  assignedToId   String?
  assignedToName String?
  rating         Int?
  satisfied      Boolean?
  claimedAt      DateTime?
  resolvedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  learner    User         @relation("TaHelpLearner", fields: [userId], references: [id], onDelete: Cascade)
  assignee   User?        @relation("TaHelpAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  replies    TaHelpReply[]

  @@index([userId, status])
  @@index([status, createdAt])
  @@index([assignedToId])
  @@index([type, status])
}

model TaHelpReply {
  id        String   @id @default(cuid())
  requestId String
  authorId  String
  authorRole String  // learner | ta
  body      String   @db.Text
  createdAt DateTime @default(now())

  request TaHelpRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author  User          @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
  @@index([authorId])
}
